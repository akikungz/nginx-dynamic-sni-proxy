DATABASE_URL=postgresql://user:password@localhost:5432/dbname
NODE_ENV=production
HAPROXY_CONFIG_PATH=/etc/haproxy/haproxy.cfg
DOMAIN_SUFFIX=yourdomain.com
LOG_LEVEL=info

# Port ranges for different protocols
SSH_PORT_START=2201
SSH_PORT_END=2299
POSTGRES_PORT_START=5433
POSTGRES_PORT_END=5533
MYSQL_PORT_START=3307
MYSQL_PORT_END=3407
REDIS_PORT_START=6380
REDIS_PORT_END=6480

# HAProxy stats
STATS_PORT=8404
STATS_USERNAME=admin
# SECURITY: Generate a strong password before deploying to production
# Example: openssl rand -base64 32
STATS_PASSWORD=changeme_generate_secure_password_here
