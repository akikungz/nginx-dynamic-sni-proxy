[Unit]
Description=HAProxy Dynamic Multi-Protocol Proxy with Database Watcher
After=network.target postgresql.service haproxy.service
Requires=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/haproxy-dynamic-proxy
Environment="DATABASE_URL=postgresql://haproxy_user:haproxy_password@localhost:5432/haproxy_db"
Environment="HAPROXY_CONFIG_PATH=/etc/haproxy/haproxy.cfg"
Environment="NODE_ENV=production"
ExecStartPre=/usr/bin/node /opt/haproxy-dynamic-proxy/dist/generate-haproxy-config.js
ExecStart=/usr/bin/node /opt/haproxy-dynamic-proxy/dist/watch-database-notify.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
